<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_matrix" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.project.matrix</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='tasks_management']" position="after">
                <h2>Matrix</h2>
                <div class="row mt16 o_settings_container" id="matrix_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="matrix_base_url"/>
                            <div class="text-muted">
                                Base URL of the Element installation used to open project rooms
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="matrix_base_url"
                                           placeholder="https://element.example.com"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
