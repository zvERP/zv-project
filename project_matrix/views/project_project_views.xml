<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_project_view_form_matrix" model="ir.ui.view">
        <field name="name">project.project.form.matrix</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        name="action_open_matrix_room"
                        type="object"
                        icon="fa-comments"
                        attrs="{'invisible': [('matrix_room_id', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Matrix Room</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='dates']" position="after">
                <label for="matrix_room_id" string="Matrix Room"/>
                <div name="matrix_room" class="o_row">
                    <field name="matrix_room_id"
                           class="oe_edit_only"
                           nolabel="1"
                           placeholder="Paste a room URL or !room:example.com"/>
                    <field name="matrix_room_url"
                           class="oe_read_only"
                           nolabel="1"
                           widget="url"
                           readonly="1"
                           attrs="{'invisible': [('matrix_room_url', '=', False)]}"/>
                    <field name="matrix_room_id"
                           class="oe_read_only"
                           nolabel="1"
                           readonly="1"
                           attrs="{'invisible': [('matrix_room_url', '!=', False)]}"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
